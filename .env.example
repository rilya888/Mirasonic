# Copy to .env and fill in. The server refuses to start without these.
#
# Credentials your Subsonic client will use. They are local to this server —
# no Google account is involved anywhere in this project.
SUBSONIC_USER=changeme
SUBSONIC_PASSWORD=changeme

# Two-letter country code for search. It MUST match the country this machine
# reaches YouTube from: stream resolution happens from the server's real IP,
# and a mismatch makes search return tracks that then fail to play.
REGION=US

# Where the container publishes its port on the host.
# Leave BIND_ADDRESS at 127.0.0.1 unless you know what you are doing.
BIND_ADDRESS=127.0.0.1
HOST_PORT=8094

# Where the library database lives on the host. The default keeps it next to
# this file, in ./data — a plain directory, so a backup is one `cp`.
LIBRARY_PATH=./data

# Optional weekly discovery agent. Leave these empty unless you run it; local
# listening history and rankings work without ListenBrainz.
LISTENBRAINZ_USER=
LISTENBRAINZ_TOKEN=
AGENT_WEEKDAY=0
AGENT_HOUR_UTC=6
AGENT_PLAYLIST_SIZE=30
